# Environment Configuration for FramePack One-Frame Inference
# Copy this file to .env and update with your paths

# Path to FramePack repository (REQUIRED)
# The FramePack repo contains the diffusers_helper modules needed for inference
FRAMEPACK_PATH=/path/to/FramePack

# Python executable (optional - defaults to 'python')
# Use this if you have a specific conda environment or python version
PYTHON_BIN=python
# Example for conda:
# PYTHON_BIN=/path/to/conda/envs/torch/bin/python

# Model paths (used by run_example.sh)
DIT_MODEL=/path/to/models/FramePackI2V_HY_bf16.safetensors
VAE_MODEL=/path/to/models/pytorch_model.pt
TEXT_ENCODER1=/path/to/models/llava_llama3_fp16.safetensors
TEXT_ENCODER2=/path/to/models/clip_l.safetensors
IMAGE_ENCODER=/path/to/models/model.safetensors

# Default input/output paths
IMAGE_PATH=./input/input.png
OUTPUT_PATH=./output/output.png
